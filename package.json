{
  "name": "dsh-ai-security-lab",
  "version": "1.0.0",
  "private": true,
  "description": "AI 模型安全测试实验室：越狱抵抗、提示词注入、隐私与指令层级、多轮对抗测试，含评分、报告与历史记录。",
  "type": "module",
  "icon": "icon.svg",
  "author": "dsh-ai-security-lab contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6977-com/dsh-ai-security-lab.git"
  },
  "homepage": "https://github.com/6977-com/dsh-ai-security-lab#readme",
  "bugs": {
    "url": "https://github.com/6977-com/dsh-ai-security-lab/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-safety",
    "red-team",
    "jailbreak",
    "prompt-injection"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.2"
  },
  "scripts": {
    "check": "node tests/syntax-check.mjs",
    "test": "node tests/syntax-check.mjs && node tests/host.test.mjs && node tests/render.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "docs",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
